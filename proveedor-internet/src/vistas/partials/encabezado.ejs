<!doctype html>
<html lang="es-MX">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#ffffff">
<title><%= titulo ? titulo + ' · ' : '' %><%= empresa %></title>
<link rel="icon" href="/static/img/logo.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="/static/css/01-variables.css">
<link rel="stylesheet" href="/static/css/02-base.css">
<link rel="stylesheet" href="/static/css/03-marco.css">
<link rel="stylesheet" href="/static/css/04-menu.css">
<link rel="stylesheet" href="/static/css/05-superior.css">
<link rel="stylesheet" href="/static/css/06-contenido.css">
<link rel="stylesheet" href="/static/css/07-avisos.css">
<link rel="stylesheet" href="/static/css/08-botones.css">
<link rel="stylesheet" href="/static/css/09-bloques.css">
<link rel="stylesheet" href="/static/css/10-tablas.css">
<link rel="stylesheet" href="/static/css/11-insignias.css">
<link rel="stylesheet" href="/static/css/12-buscador.css">
<link rel="stylesheet" href="/static/css/13-listas.css">
<link rel="stylesheet" href="/static/css/14-formularios.css">
<link rel="stylesheet" href="/static/css/15-tablero.css">
<link rel="stylesheet" href="/static/css/16-acceso.css">
<link rel="stylesheet" href="/static/css/17-tiempo-real.css">
<link rel="stylesheet" href="/static/css/18-contorno.css">
<link rel="stylesheet" href="/static/css/responsive.css">
<link rel="stylesheet" href="/static/css/19-tema.css">
<script src="/static/js/tema.js"></script>
<script src="/static/js/app.js" defer></script>
</head>
<body>
<a class="saltar" href="#contenido">Saltar al contenido</a>
<% if (usuario) { %>
<div class="marco">
  <aside class="lateral">
    <a class="marca" href="/"><%- include('iconos', { icono: 'antena' }) %><span><%= empresa %></span></a>
    <%- include('menu') %>
  </aside>
  <div class="area">
    <header class="superior">
      <a class="marca marca-movil" href="/"><%- include('iconos', { icono: 'antena' }) %><span><%= empresa %></span></a>
      <div class="cuenta">
        <span class="cuenta-usuario"><%- include('iconos', { icono: 'usuario' }) %><%= usuario.correo %> · <%= usuario.rol %></span>
        <button type="button" class="cuenta-enlace boton-tema cuenta-tema" data-tema-alternar aria-pressed="false"><span data-tema-texto>Modo oscuro</span></button>
        <a class="cuenta-enlace" href="/mi-cuenta"><%- include('iconos', { icono: 'engrane' }) %>Mi cuenta</a>
        <form method="post" action="/logout" class="form-salir">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="boton-salir"><%- include('iconos', { icono: 'salir' }) %>Salir</button>
        </form>
        <details class="menu-movil">
          <summary>Menú</summary>
          <div class="menu-movil-panel">
            <button type="button" class="boton secundario movil-tema" data-tema-alternar aria-pressed="false"><span data-tema-texto>Modo oscuro</span></button>
            <p class="menu-movil-usuario"><%= usuario.correo %> · <%= usuario.rol %> · <a href="/mi-cuenta">Mi cuenta</a></p>
            <%- include('menu') %>
          </div>
        </details>
      </div>
    </header>
    <main id="contenido" class="contenido">
<% } else { %>
<main id="contenido" class="contenido contenido-solo">
<% } %>
<% if (aviso) { %><div class="aviso aviso-<%= aviso.tipo %>" role="status"><%= aviso.texto %></div><% } %>
